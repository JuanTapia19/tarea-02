      "source": [
        "# Recorremos los números del 1 al 100. (Usamos 101 para que el 100 quede incluido).\n",
        "for numero in range(1, 101):\n",
        "\n",
        "    # Verificamos si el número es divisible por 5.\n",
        "    # El operador '%' nos da el resto de la división. Si es igual a 0, es divisible.\n",
        "    if numero % 5 == 0:\n",
        "\n",
        "        # Una vez que sabemos que es divisible por 5, revisamos si también es divisible por 10.\n",
        "        # Es clave hacer esta pregunta aquí adentro, porque todo múltiplo de 10 es múltiplo de 5.\n",
        "        if numero % 10 == 0:\n",
        "            print(f\"{numero} Bip Bip\")\n",
        "\n",
        "        # Si el número es divisible por 5 pero falla la prueba del 10 (ej: 5, 15, 25)\n",
        "        else:\n",
        "            print(f\"{numero} Bip\")"
      ]
