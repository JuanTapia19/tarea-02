      "source": [
        "# Pedimos el primer número al usuario.\n",
        "# Usamos int() para asegurarnos de que Python lo entienda como un número entero y no como texto.\n",
        "numero1 = int(input(\"Por favor, ingresa el primer número: \"))\n",
        "\n",
        "# Pedimos el segundo número usando la misma lógica.\n",
        "numero2 = int(input(\"Por favor, ingresa el segundo número: \"))\n",
        "\n",
        "# Realizamos la suma de las variables que guardaron los números\n",
        "suma = numero1 + numero2\n",
        "\n",
        "# Mostramos el resultado de la operación para darle feedback al usuario\n",
        "print(f\"\\nLa suma de tus números es: {suma}\")\n",
        "\n",
        "# Evaluamos el resultado según las reglas pedidas\n",
        "if suma < 50:\n",
        "    print(\"Nivel principiante\")\n",
        "\n",
        "# Si llegó a este 'elif', la suma ya es 50 o mayor.\n",
        "# Solo necesitamos comprobar que sea menor a 80.\n",
        "elif suma < 80:\n",
        "    print(\"Nivel intermedio\")\n",
        "\n",
        "# Si no es menor que 50, ni menor que 80, por descarte es 80 o más.\n",
        "else:\n",
        "    print(\"Nivel pro\")"
      ]
